# Copy to a deployment-only .env file. Do not commit actual credentials.
OCRKIT_R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
OCRKIT_R2_ACCESS_KEY_ID=<r2-access-key-id>
OCRKIT_R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
OCRKIT_R2_REGION_NAME=auto
OCRKIT_R2_DEFAULT_BUCKET=<bucket>
OCRKIT_R2_ALLOWED_BUCKETS=<bucket>
OCRKIT_MODEL_MANIFEST_KEY=models/pp-ocrv6-small/<version>/manifest.json
OCRKIT_MODEL_DOWNLOAD_TIMEOUT_SECONDS=30
