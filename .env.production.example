# Deployment-only file for US-LOS-C-1. Copy to .env; never commit it.
OCRKIT_IMAGE=ghcr.io/owbastion/ocrkit@sha256:<published-image-digest>
CLOUDFLARED_IMAGE=cloudflare/cloudflared@sha256:<published-image-digest>
CLOUDFLARE_TUNNEL_TOKEN=<tunnel-token-for-ocr.owbastion.com>
OCRKIT_API_TOKEN=<long-random-service-token>
OCRKIT_R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
OCRKIT_R2_ACCESS_KEY_ID=<read-only-r2-access-key-id>
OCRKIT_R2_SECRET_ACCESS_KEY=<read-only-r2-secret-access-key>
OCRKIT_R2_REGION_NAME=auto
# OCRKit model bucket only; do not set this to platform evidence.
OCRKIT_R2_DEFAULT_BUCKET=<ocrkit-model-bucket>
# Include the model bucket and owbastion-codes-evidence.
OCRKIT_R2_ALLOWED_BUCKETS=<ocrkit-model-bucket>,owbastion-codes-evidence
OCRKIT_MODEL_MANIFEST_KEY=models/pp-ocrv6-small/<version>/manifest.json
OCRKIT_MODEL_DOWNLOAD_TIMEOUT_SECONDS=30
OCRKIT_R2_READ_TIMEOUT_SECONDS=10
